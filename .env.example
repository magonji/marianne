# Copia este fichero a .env (está en .gitignore) y rellénalo.
HASS_TOKEN=
OPENWEATHER_KEY=
TZ=Europe/London
# Enlaces iCal privados de tus calendarios (Google: Configuración del calendario → Dirección secreta en formato iCal).
ICAL_PERSONAL=
# La carpeta de la música para el iPod, en el equipo donde corre Docker (se monta en /music).
MUSIC_FOLDER=
